# Production Environment Variables Template
# Copy this file to .env.production and replace all placeholder values
# NEVER commit this file to git if it contains real secrets

# Application
NODE_ENV=production
FRONTEND_URL=https://flowsuite.example.com
API_URL=https://api.flowsuite.example.com

# Database (use strong password in production)
POSTGRES_USER=flowsuite
POSTGRES_PASSWORD=<generate-secure-password-min-16-chars>
POSTGRES_DB=flowsuite
DATABASE_URL=postgresql://flowsuite:<password>@postgres:5432/flowsuite?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=<generate-random-secret-min-32-chars>
JWT_REFRESH_SECRET=<generate-random-secret-min-32-chars>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Live Keys (from https://dashboard.stripe.com/apikeys - use LIVE mode)
STRIPE_SECRET_KEY=sk_live_<your-live-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# Database Admin
PGADMIN_EMAIL=admin@flowsuite.dev
PGADMIN_PASSWORD=<generate-secure-password>

# Port mappings (can be customized)
POSTGRES_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=3000
FRONTEND_PORT=80
PGADMIN_PORT=5050
