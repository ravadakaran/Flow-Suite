# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://flowsuite:flowsuite_secret@localhost:5432/flowsuite?schema=public"
POSTGRES_USER=flowsuite
POSTGRES_PASSWORD=flowsuite_secret
POSTGRES_DB=flowsuite

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here
# pgAdmin
PGADMIN_EMAIL=admin@flowsuite.dev
PGADMIN_PASSWORD=admin

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
